# Anthropic Claude API credentials (REQUIRED)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database connection for agent tools (REQUIRED)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Optional: Override Claude model (default: claude-haiku-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5

# Port for local development (Cloud Run sets this automatically in production)
# PORT=8080
