# Fintoc API credentials
FINTOC_SECRET_KEY=your_fintoc_secret_key_here
FINTOC_PUBLIC_KEY=your_fintoc_public_key_here
LINK_TOKEN=your_fintoc_link_token_here
DATABASE_URL=your_database_url_here

# To fork into own .env
# cp .env.example .env

# Terminal 1: Start ngrok
# ngrok http 8000

# Terminal 2: Start your FastAPI app
# uvicorn main:app --reload --port 8000